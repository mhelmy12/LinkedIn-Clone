{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "PostServiceTopic": "postService.LinkedInDb.dbo.OutboxMessages",
    "EngagementServiceTopic": "engagementService.LinkedInDb.public.OutboxMessages",
    "UserServiceTopic": "userService.LinkedInDb.dbo.OutboxMessages",
    "ConsumerPollTimeoutMs": 500
  },

  "Feed": {
    "MaxFeedSize": 1000,
    "InitialFanOutSize": 100,
    "DefaultPageSize": 20,
    "MaxPageSize": 50,
    "FeedTtlDays": 30,
    "ConnectionCacheTtlDays": 7
  }
}

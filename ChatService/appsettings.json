{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Chat": {
    "SnowflakeWorkerId": 5,
    "Cors": {
      "Origins": [
        "http://localhost:3000"
      ]
    },
    "Push": {
      "Provider": "Logging",
      "Enabled": false
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "UserServiceTopic": "userService.LinkedInUserDb.dbo.OutboxMessages",
    "ConsumerPollTimeoutMs": 500,
    "MaxRetryAttempts": 3,
    "DeadLetterTopic": "chat-service-dlq"
  }
}

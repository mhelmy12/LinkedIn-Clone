      "link": null,
      "locked": false,
      "text": "post already deleted: return 404\npost never existed: return 404\nauthorId != currentUserId: return 403\nPost has 500 Reposts: remove all and send them in the event\npost has Quotes: keep them with orphan originalPostId\npos has reactions and comments: keep them + each service will decide\npost has media: keep them in MINIO\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "post already deleted: return 404\npost never existed: return 404\nauthorId != currentUserId: return 403\nPost has 500 Reposts: remove all and send them in the event\npost has Quotes: keep them with orphan originalPostId\npos has reactions and comments: keep them + each service will decide\npost has media: keep them in MINIO\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

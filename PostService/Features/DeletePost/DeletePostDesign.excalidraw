    {
      "id": "7g84IbUqUReirbbr_2HgC",
      "type": "text",
      "x": 4365.65891023702,
      "y": 58.44245713046533,
      "width": 839.5794067382812,
      "height": 850,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 1385829454,
      "version": 303,
      "versionNonce": 881881998,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789915583180,
      "link": null,
      "locked": false,
      "text": "1. SearchService\n\nPostDeletedEvent → ES: Delete document\n\n--code--\nawait _es.DeleteAsync<PostDocument>(postId.ToString(), d => d.Index(\"posts\"), ct);\n-----------------------------------------------------------\n\n2. FeedService\n\nPostDeletedEvent → Redis: ZREM from feeds\n\n ZREM?\n- Author's connections (who see the post)\n- Author \nRepost (RepostedByUserIds)\n\n\n--code--\n\n// Author\nawait _feedCache.RemoveFromFeedAsync(authorId, postId);\n\n// Mentions + Reposters \nforeach (var userId in mentioned.Concat(reposted))\n    await _feedCache.RemoveFromFeedAsync(userId, postId);\n\n// Connections\nvar connections = await _connections.GetConnectionsAsync(authorId);\nforeach (var conn in connections)\n    await _feedCache.RemoveFromFeedAsync(conn, postId);\n\n\nnote: ZREM idempotent if record not found",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. SearchService\n\nPostDeletedEvent → ES: Delete document\n\n--code--\nawait _es.DeleteAsync<PostDocument>(postId.ToString(), d => d.Index(\"posts\"), ct);\n-----------------------------------------------------------\n\n2. FeedService\n\nPostDeletedEvent → Redis: ZREM from feeds\n\n ZREM?\n- Author's connections (who see the post)\n- Author \nRepost (RepostedByUserIds)\n\n\n--code--\n\n// Author\nawait _feedCache.RemoveFromFeedAsync(authorId, postId);\n\n// Mentions + Reposters \nforeach (var userId in mentioned.Concat(reposted))\n    await _feedCache.RemoveFromFeedAsync(userId, postId);\n\n// Connections\nvar connections = await _connections.GetConnectionsAsync(authorId);\nforeach (var conn in connections)\n    await _feedCache.RemoveFromFeedAsync(conn, postId);\n\n\nnote: ZREM idempotent if record not found",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hIIx1Phdlz4_bu4oS6EYg",
      "type": "text",
      "x": 2357.9445046322458,
      "y": 523.1568169588704,
      "width": 493.539794921875,

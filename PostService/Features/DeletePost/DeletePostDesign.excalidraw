    {
      "id": "IRBEnFf-ihTsZbBZHMyJ9",
      "type": "text",
      "x": 3326.233220708941,
      "y": 26.23932013253784,
      "width": 830.799560546875,
      "height": 1350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 1072490028,
      "version": 1841,
      "versionNonce": 339891410,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789915151634,
      "link": null,
      "locked": false,
      "text": "┌────────────────────────────────────────────────────────┐\n│  1. Client → YARP                                                                             │\n│     DELETE /api/posts/{id}                                                               │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  2. YARP → PostService                                                                     │\n│     - Auth │\n│     - X-User-Id injected                                                                      │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  3. PostService Endpoint                                                                    │\n│     → DeletePostCommand                                                                   │\n│     → MediatR Pipeline                                                                       │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  4. DeletePostHandler                                                                       │\n│                                                                                                   │ \n│  ① Load Post (AsNoTracking)                                                             │\n│  ② Not found / already deleted → 404                                                  │\n│  ③ Author != CurrentUser       → 403                                                   │\n│  ④ Collect mentions + reposters                                                          │ \n│  ⑤ Set DeletedAt = now                                                                   │\n│  ⑥ Hard delete PostReposts                                                              │\n│  ⑦ Outbox: PostDeletedEvent                                                            │\n│  ⑧ SaveChanges                                                                              │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  5. SQL Server Transaction                                                                 │\n│     BEGIN TRAN                                                                             │\n│       UPDATE Posts SET DeletedAt = @now WHERE Id = @id                      │\n│       DELETE FROM PostReposts WHERE OriginalPostId=@id                      │\n│       INSERT INTO OutboxMessages (PostDeletedEvent)                           │ \n│     COMMIT                                                                                   │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  6. Debezium → Kafka                                                                        │\n│     Event: PostDeletedEvent                                                               │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n       ┌─────────────────┼─────────────────┐\n       ▼                              ▼                             ▼\n  ┌──────────┐    ┌──────────┐    ┌──────────────┐\n  │ Search         │    │  Feed          │    │ Notification         │\n  ├──────────┤    ├──────────┤    ├──────────────┤\n  │ ES:             │    │       Redis:   │    │          (optional)   │\n  │ Delete         │    │     ZREM     │    │         mark as      │\n  │ document      │    │       from     │    │           invalid      │\n  │                  │    │      feeds     │    │                        │\n  └──────────┘    └──────────┘    └──────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌────────────────────────────────────────────────────────┐\n│  1. Client → YARP                                                                             │\n│     DELETE /api/posts/{id}                                                               │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  2. YARP → PostService                                                                     │\n│     - Auth │\n│     - X-User-Id injected                                                                      │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  3. PostService Endpoint                                                                    │\n│     → DeletePostCommand                                                                   │\n│     → MediatR Pipeline                                                                       │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  4. DeletePostHandler                                                                       │\n│                                                                                                   │ \n│  ① Load Post (AsNoTracking)                                                             │\n│  ② Not found / already deleted → 404                                                  │\n│  ③ Author != CurrentUser       → 403                                                   │\n│  ④ Collect mentions + reposters                                                          │ \n│  ⑤ Set DeletedAt = now                                                                   │\n│  ⑥ Hard delete PostReposts                                                              │\n│  ⑦ Outbox: PostDeletedEvent                                                            │\n│  ⑧ SaveChanges                                                                              │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  5. SQL Server Transaction                                                                 │\n│     BEGIN TRAN                                                                             │\n│       UPDATE Posts SET DeletedAt = @now WHERE Id = @id                      │\n│       DELETE FROM PostReposts WHERE OriginalPostId=@id                      │\n│       INSERT INTO OutboxMessages (PostDeletedEvent)                           │ \n│     COMMIT                                                                                   │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n┌────────────────────────────────────────────────────────┐\n│  6. Debezium → Kafka                                                                        │\n│     Event: PostDeletedEvent                                                               │\n└────────────────────────┬───────────────────────────────┘\n                                            ▼\n       ┌─────────────────┼─────────────────┐\n       ▼                              ▼                             ▼\n  ┌──────────┐    ┌──────────┐    ┌──────────────┐\n  │ Search         │    │  Feed          │    │ Notification         │\n  ├──────────┤    ├──────────┤    ├──────────────┤\n  │ ES:             │    │       Redis:   │    │          (optional)   │\n  │ Delete         │    │     ZREM     │    │         mark as      │\n  │ document      │    │       from     │    │           invalid      │\n  │                  │    │      feeds     │    │                        │\n  └──────────┘    └──────────┘    └──────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m-8eNU8y8HINI6FEypcDH",

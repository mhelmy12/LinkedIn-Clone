      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "Zz",
      "roundness": null,
      "seed": 356050220,
      "version": 911,
      "versionNonce": 980637390,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789916307072,
      "link": null,
      "locked": false,
      "text": "1- who can delete?\n    AuthorId == CurrentUserId\n\n2- Time Limit \n    at any time\n\n3- PurePost ?\n        mark all records related ot this post in PostRepost Table as deleted\n    QuotedPost?\n        mark original Post of it as null \n        Frontend->\"This post is no longer available\"\n    \n\n\n4- Undelete\n    handled by frontend\n\n5- Post already deleted\n    return 404 NotFound\n\n",
      "fontSize": 19.739096654649927,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- who can delete?\n    AuthorId == CurrentUserId\n\n2- Time Limit \n    at any time\n\n3- PurePost ?\n        mark all records related ot this post in PostRepost Table as deleted\n    QuotedPost?\n        mark original Post of it as null \n        Frontend->\"This post is no longer available\"\n    \n\n\n4- Undelete\n    handled by frontend\n\n5- Post already deleted\n    return 404 NotFound\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },

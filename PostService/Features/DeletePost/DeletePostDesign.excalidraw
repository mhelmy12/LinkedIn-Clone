    {
      "id": "YBDskZEN1o1eIeIu3DZQG",
      "type": "text",
      "x": 1513.0751048410023,
      "y": 228.57861085849117,
      "width": 798.5356997535338,
      "height": 518.1512871845606,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

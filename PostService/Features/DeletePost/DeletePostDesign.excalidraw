    {
      "id": "iCsi6vxnC7BFWdu-lEvd9",
      "type": "line",
      "x": 3231.2455995994837,
      "y": 45.40834464541905,
      "width": 5.543673143245087,
      "height": 1868.0742422970532,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

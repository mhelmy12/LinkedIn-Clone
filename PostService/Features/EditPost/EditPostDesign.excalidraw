      "link": null,
      "locked": false,
      "text": "public record EditPostCommand(\n    Guid PostId,\n    string? Content,                // null =  not changed\n    PostVisibility? Visibility,     // null = not changed\n    List<MediaInput>? Media,        // null = not changed | empty = delete all \n    List<MentionInput>? Mentions,   // null = not changed\n) : IRequest<Result<EditPostResponse>>;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public record EditPostCommand(\n    Guid PostId,\n    string? Content,                // null =  not changed\n    PostVisibility? Visibility,     // null = not changed\n    List<MediaInput>? Media,        // null = not changed | empty = delete all \n    List<MentionInput>? Mentions,   // null = not changed\n) : IRequest<Result<EditPostResponse>>;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iCsi6vxnC7BFWdu-lEvd9",
      "type": "line",
      "x": 3231.2455995994837,

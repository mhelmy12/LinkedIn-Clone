    {
      "id": "IRBEnFf-ihTsZbBZHMyJ9",
      "type": "text",
      "x": 3325.7188251313746,
      "y": 29.025008260327922,
      "width": 895.1893920898438,
      "height": 1900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 1072490028,
      "version": 658,
      "versionNonce": 1009701548,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789833066618,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────────────────────────┐\n│  1. Client → YARP                                        │\n│     PATCH /api/posts/{id}                                │\n│     Body: { content?, visibility?, media?, mentions? }   │\n│     Headers: If-Match: <rowVersion>                      │\n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  2. YARP → PostService                                  \n│     - Auth ✅                                            \n│     - X-User-Id injected                                 \n│     - Route to PostService                               \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  3. PostService Endpoint                                 \n│     → EditPostCommand                                  \n│     → MediatR Pipeline                                   \n├         ──ValidationBehavior                           \n│        └──LoggingBehavior \n           |__TransactionBehavior                           \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  4. EditPostHandler                                      \n│                                                          \n│  ① Load Post (with Media, Mentions, Hashtags)           \n│  ② Check exists && !deleted      → 404                  \n│  ③ Check AuthorId == CurrentUser → 403               \n│  ④ Check Time limit (1 hour)     → 422/400             \n│  ⑤ Check RowVersion              → 409                  \n│  ⑥ Apply changes (Partial)                              \n│  ⑦ Set UpdatedAt = now                               \n│  ⑧ Write Outbox: PostUpdatedEvent                \n│  ⑨ SaveChanges (atomic)                               \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  5. SQL Server Transaction (atomic)                     \n│     BEGIN TRAN                                           \n│       UPDATE Posts SET ...                             \n│       DELETE FROM PostMedia WHERE PostId = @id\n│       INSERT INTO PostMedia (new)                    \n│       DELETE FROM PostMentions WHERE PostId = @id      \n│       INSERT INTO PostMentions (new)                     \n│       DELETE FROM PostHashtags WHERE PostId = @id       \n│       INSERT INTO PostHashtags (new)                     \n│       INSERT INTO OutboxMessages (PostUpdatedEvent)     \n│     COMMIT                                               \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  6. Debezium → Kafka                                                                          \n│     Topic: postService.dbo.OutboxMessages                                                 \n│     Event: PostUpdatedEvent                              \n└────────────────────────┬────────────────────────────────┘\n                         │\n          ┌──────────────┼──────────────┐\n          ▼                        ▼                         ▼\n    ┌──────────┐  ┌──────────┐  ┌──────────────┐\n    │ Search         │            Feed    │  │ Notification         │\n    │ Service         │           Service  │  │  Service              │\n    └────┬─────┘  └────┬─────┘  └──────┬───────┘\n             │                     │\nCheck bool variables (ContentChanged,VisibilityChanged,MediaChanged)                         │\n             ▼                    ▼                         ▼\n    ┌──────────┐  ┌──────────┐  ┌──────────────┐\n    │ ES              │  │ Update        │  │ Mention diff        │\n    │ re-index        │  │ Read          │  │ → notify new        │\n    │                  │  │ Model          │  │   mentions           │\n    └──────────┘  └──────────┘  └──────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────────────────────────┐\n│  1. Client → YARP                                        │\n│     PATCH /api/posts/{id}                                │\n│     Body: { content?, visibility?, media?, mentions? }   │\n│     Headers: If-Match: <rowVersion>                      │\n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  2. YARP → PostService                                  \n│     - Auth ✅                                            \n│     - X-User-Id injected                                 \n│     - Route to PostService                               \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  3. PostService Endpoint                                 \n│     → EditPostCommand                                  \n│     → MediatR Pipeline                                   \n├         ──ValidationBehavior                           \n│        └──LoggingBehavior \n           |__TransactionBehavior                           \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  4. EditPostHandler                                      \n│                                                          \n│  ① Load Post (with Media, Mentions, Hashtags)           \n│  ② Check exists && !deleted      → 404                  \n│  ③ Check AuthorId == CurrentUser → 403               \n│  ④ Check Time limit (1 hour)     → 422/400             \n│  ⑤ Check RowVersion              → 409                  \n│  ⑥ Apply changes (Partial)                              \n│  ⑦ Set UpdatedAt = now                               \n│  ⑧ Write Outbox: PostUpdatedEvent                \n│  ⑨ SaveChanges (atomic)                               \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  5. SQL Server Transaction (atomic)                     \n│     BEGIN TRAN                                           \n│       UPDATE Posts SET ...                             \n│       DELETE FROM PostMedia WHERE PostId = @id\n│       INSERT INTO PostMedia (new)                    \n│       DELETE FROM PostMentions WHERE PostId = @id      \n│       INSERT INTO PostMentions (new)                     \n│       DELETE FROM PostHashtags WHERE PostId = @id       \n│       INSERT INTO PostHashtags (new)                     \n│       INSERT INTO OutboxMessages (PostUpdatedEvent)     \n│     COMMIT                                               \n└────────────────────────┬────────────────────────────────┘\n                         │\n                         ▼\n┌─────────────────────────────────────────────────────────┐\n│  6. Debezium → Kafka                                                                          \n│     Topic: postService.dbo.OutboxMessages                                                 \n│     Event: PostUpdatedEvent                              \n└────────────────────────┬────────────────────────────────┘\n                         │\n          ┌──────────────┼──────────────┐\n          ▼                        ▼                         ▼\n    ┌──────────┐  ┌──────────┐  ┌──────────────┐\n    │ Search         │            Feed    │  │ Notification         │\n    │ Service         │           Service  │  │  Service              │\n    └────┬─────┘  └────┬─────┘  └──────┬───────┘\n             │                     │\nCheck bool variables (ContentChanged,VisibilityChanged,MediaChanged)                         │\n             ▼                    ▼                         ▼\n    ┌──────────┐  ┌──────────┐  ┌──────────────┐\n    │ ES              │  │ Update        │  │ Mention diff        │\n    │ re-index        │  │ Read          │  │ → notify new        │\n    │                  │  │ Model          │  │   mentions           │\n    └──────────┘  └──────────┘  └──────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m-8eNU8y8HINI6FEypcDH",
      "type": "text",
      "x": 2375.3720615205348,
      "y": 504.1204798925419,
      "width": 379.579833984375,
      "height": 300,
      "angle": 0,

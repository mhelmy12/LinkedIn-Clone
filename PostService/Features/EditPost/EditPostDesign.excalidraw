      "boundElements": [],
      "updated": 1789888687489,
      "link": null,
      "locked": false,
      "text": "Content and media are null: return 400\nmedia is null: do not change anything\nmedia is []: remove all\nmentions is null: do not change anything\nPost is Quoted: can be edited\nPost is Pure: return 404\nTime Limit Exceeded: return 422\ncontent is null: do not change anything and do not fire event and return 202 ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Content and media are null: return 400\nmedia is null: do not change anything\nmedia is []: remove all\nmentions is null: do not change anything\nPost is Quoted: can be edited\nPost is Pure: return 404\nTime Limit Exceeded: return 422\ncontent is null: do not change anything and do not fire event and return 202 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
